  <ItemGroup>
    <ProjectReference Include="..\..\dev\HumanoidRetargeter.Dev.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Solve\MixamoNeckDiagTemp.cs" />
    <Compile Include="../PosedLocomotion/*.cs" />
