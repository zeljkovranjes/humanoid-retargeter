  <ItemGroup>
    <None Include="..\..\dev\HumanoidRetargeter.Tests\fixtures\**\*" Link="fixtures\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

